<odoo>
  <record id="ir_cron_cf_keyword_refresh" model="ir.cron">
    <field name="name">Keyword Tracker: daily position refresh</field>
    <field name="model_id" ref="model_cf_keyword_tracker"/>
    <field name="state">code</field>
    <field name="code">model._cf_cron_refresh_all()</field>
    <field name="interval_number">1</field>
    <field name="interval_type">days</field>
    <field name="active" eval="True"/>
  </record>
</odoo>
