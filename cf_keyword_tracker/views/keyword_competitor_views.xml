<odoo>

  <record id="view_cf_keyword_competitor_list" model="ir.ui.view">
    <field name="name">cf.keyword.competitor.list</field>
    <field name="model">cf.keyword.competitor</field>
    <field name="arch" type="xml">
      <list string="Competitors">
        <field name="name"/>
        <field name="keywords_tracked"/>
        <field name="keywords_ahead" decoration-danger="keywords_ahead &gt; 0"/>
        <field name="avg_position"/>
      </list>
    </field>
  </record>

  <record id="view_cf_keyword_competitor_form" model="ir.ui.view">
    <field name="name">cf.keyword.competitor.form</field>
    <field name="model">cf.keyword.competitor</field>
    <field name="arch" type="xml">
      <form string="Competitor">
        <sheet>
          <div class="oe_title">
            <label for="name"/>
            <h1><field name="name" placeholder="e.g. competitor.com"/></h1>
          </div>
          <group>
            <group string="How they compare">
              <field name="keywords_tracked"/>
              <field name="keywords_ahead"/>
              <field name="avg_position"/>
            </group>
            <group>
              <field name="website_id"/>
              <field name="active"/>
            </group>
          </group>
          <notebook>
            <page string="Positions per keyword">
              <field name="rank_ids" readonly="1">
                <list>
                  <field name="name" string="Keyword"/>
                  <field name="position" string="Their position"/>
                  <field name="our_position" string="Your position"/>
                  <field name="url" widget="url"/>
                  <field name="date"/>
                </list>
              </field>
            </page>
          </notebook>
        </sheet>
      </form>
    </field>
  </record>

  <record id="action_cf_keyword_competitor" model="ir.actions.act_window">
    <field name="name">Competitors</field>
    <field name="res_model">cf.keyword.competitor</field>
    <field name="view_mode">list,form</field>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">Add a competitor to watch</p>
      <p>Enter a competitor's domain (e.g. <b>competitor.com</b>). On each
      refresh the tracker records where that competitor ranks for every keyword
      you track, so you can see who is ahead of you. Needs a SERP provider
      (DataForSEO or SerpApi); Google Search Console only reports your own site.</p>
    </field>
  </record>

</odoo>
